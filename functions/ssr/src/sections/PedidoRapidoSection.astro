---
/*
  PEDIDO RÁPIDO — a seção que justifica esta variante existir.

  Papelaria de escritório não é compra de descoberta: é reposição. O mesmo
  comprador pede quase a mesma lista todo mês, e a navegação por vitrine é
  atrito puro para ele — vinte itens viram mais de cem cliques.

  Esta seção troca a navegação inteira por uma caixa de texto. É a mesma ideia
  do "quick order" de distribuidor B2B, e é o que separa a Pauta da Bitola: as
  duas são B2B, mas a Bitola resolve ESPECIFICAÇÃO (que peça serve) e a Pauta
  resolve REPETIÇÃO (o mesmo pedido de novo).

  A parte interativa vive em `components/PedidoRapido.vue` — ela precisa
  resolver cada código contra a API e mexer no carrinho, e isso é trabalho de
  componente, não de `<script>` solto. O porquê da mudança está no cabeçalho
  de lá.
*/
import type { CmsFields, InferCmsOutput } from '@@sf/content';
import PedidoRapido from '~/components/PedidoRapido.vue';

export const cmsFields = ({
  title: {
    widget: 'string',
    label: { pt: 'Título', en: 'Title' },
  },
}) as const satisfies CmsFields;

export type Props = InferCmsOutput<typeof cmsFields>;
const { title = 'Pedido rápido' } = Astro.props;

/*
  A base da API vai como prop porque o componente resolve os códigos no
  cliente, e lá `process.env` não existe. `ECOM_STORE_ID` vem do `.env` de
  `functions/ssr` (ver `demo-catalog/scripts/criar-env-dev.sh`); o `1011` é o
  mesmo fallback que o storefront usa quando a variável falta.
*/
const storeId = process.env.ECOM_STORE_ID || '1011';
const apiBase = `${process.env.API_BASE_URL || 'https://ecomplus.io/v2'}/:${storeId}`;
---

<section class="ui-section">
  <div class="grid gap-6 border border-base-200 bg-base-50 p-6 md:grid-cols-2
    md:gap-10 md:p-8">
    <div>
      <h2 class="ui-text-brand text-2xl leading-tight text-base-900 md:text-3xl">
        {title}
      </h2>
      <p class="mt-3 text-sm leading-relaxed text-base-700">
        Já sabe o que precisa? <span class="ui-grifo">Cole a lista inteira de
        uma vez</span> — um código por linha, com a quantidade ao lado. Não
        precisa navegar o catálogo.
      </p>

      <dl class="mt-5 space-y-2.5 text-sm">
        <div class="flex gap-3">
          <dt class="ui-codigo shrink-0 pt-0.5">FORMATO</dt>
          <dd class="text-base-600">
            <code class="font-mono">CÓDIGO, QUANTIDADE</code> — vírgula, ponto e
            vírgula, tabulação ou espaço, tanto faz.
          </dd>
        </div>
        <div class="flex gap-3">
          <dt class="ui-codigo shrink-0 pt-0.5">SEM QTD</dt>
          <dd class="text-base-600">Linha sem número vale como 1 unidade.</dd>
        </div>
        <div class="flex gap-3">
          <dt class="ui-codigo shrink-0 pt-0.5">ONDE ACHO</dt>
          <dd class="text-base-600">
            O código fica no card de cada produto. Um clique nele seleciona
            inteiro, pronto para copiar.
          </dd>
        </div>
      </dl>

      <p class="mt-5 text-[0.6875rem] leading-relaxed text-base-500">
        A conferência consulta o catálogo de verdade e o botão adiciona tudo ao
        carrinho. O checkout é que não fecha nas demos — vale para as quinze.
      </p>
    </div>

    <!--
      `client:sf="load"` e não `lazy,interaction`.

      Com hidratação adiada o componente sobe como HTML morto: quem começa a
      digitar antes de o Vue assumir perde as primeiras teclas, e o botão
      continua desabilitado porque o `v-model` nunca viu o texto. Foi
      reproduzido com o campo preenchido e o botão preso em `disabled`.

      Numa vitrine isso é aceitável — a `ProductShelf` usa `lazy,interaction` e
      o pior caso é um card demorar a responder. Aqui não: este formulário é a
      razão de a página existir, e o custo de subir o JS junto com a página é
      menor que o de perder a primeira interação. Mesmo motivo pelo qual
      `ProductDetails` e `SearchShowcase` usam `load`.
    -->
    <PedidoRapido {apiBase} client:sf="load" />
  </div>
</section>
